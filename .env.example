# ============================================================================
# MoM — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# ============================================================================

# ---- HuggingFace (REQUIRED) -------------------------------------------------
# Needed to download pyannote diarization models. Create a "Read" token at
# https://huggingface.co/settings/tokens and accept the terms on BOTH:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_your_token_here

# ---- LLM provider (choose ONE: Option A or Option B) ------------------------
# Used for transcript polish, translation and meeting summary.

# Option A — regular OpenAI (platform.openai.com)
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4o-mini
GPT_POLISH_MODEL=gpt-4o-mini
GPT_TRANSLATE_MODEL=gpt-4o

# Option B — Azure OpenAI. Setting AZURE_OPENAI_ENDPOINT switches to Azure.
# Deployment names are the names YOU gave in Azure (not model ids).
# All three may point to the same deployment.
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_TRANSLATE=gpt-4o
# AZURE_OPENAI_DEPLOYMENT_POLISH=gpt-4o-mini
# AZURE_OPENAI_DEPLOYMENT_SUMMARY=gpt-4o-mini

# ---- Speech-to-text (Whisper) -----------------------------------------------
# Model size: tiny | base | small | medium | large-v3
# large-v3 = best quality but slow on CPU; medium = ~3x faster.
WHISPER_MODEL=large-v3
# cpu | cuda (cuda needs an NVIDIA GPU)
WHISPER_DEVICE=cpu
# int8 for CPU, float16 for GPU
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

# Optional per-language HuggingFace model overrides (leave blank = use WHISPER_MODEL)
WHISPER_MODEL_MR=
WHISPER_MODEL_HI=

# ---- Speed ------------------------------------------------------------------
# Fast model for English; in Auto mode it also detects the language
WHISPER_MODEL_EN=small
# CPU threads for Whisper (0 = all cores)
WHISPER_CPU_THREADS=0
# Hindi/Marathi beam size (retries are off for these; 1 = ~6x faster on CPU)
WHISPER_BEAM_SIZE_INDIC=1
# pyannote window step (fraction of 10 s); 0.5 = ~5x faster than default 0.1
DIARIZATION_STEP=0.5

# GPT cleanup of mis-heard words in all languages (code default: false)
POLISH_TRANSCRIPT=true

# ---- Speaker recognition ------------------------------------------------------
# Cosine distance for a confident match; lower = stricter.
SPEAKER_MATCH_THRESHOLD=0.45
# Up to this distance a match is accepted only if clearly ahead of the runner-up
SPEAKER_MATCH_LOOSE=0.6
SPEAKER_MATCH_MARGIN=0.1
# Voiceprint similarity for grouping turns as one person
# (raise if two people get merged, lower if one person gets split)
SPEAKER_CLUSTER_SIMILARITY=0.3

# ---- Storage (defaults shown; folders are auto-created) ----------------------
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
ENROLL_DIR=./data/enrollments
MEETINGS_DIR=./data/meetings